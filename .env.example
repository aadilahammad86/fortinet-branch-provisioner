# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
FGT_HOST=172.21.0.1
FGT_USER=admin
FGT_PASSWORD=

# wan1 PPPoE (ISP) credentials — fill these in for plug-and-play
FGT_PPPOE_USER=
FGT_PPPOE_PASS=

# Optional: where the GUI saves config backups. Leave blank for a `configs`
# folder next to the program. A .env placed beside the .exe is read too.
FGT_BACKUP_DIR=
